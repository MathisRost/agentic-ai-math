{
  "schema_version": 2,
  "kind": "coordinator_interpreted_manifest",
  "created": "2026-10-20",
  "status": "prepared_not_started",
  "model": "gpt-6-astra",
  "reasoning_effort": "xhigh",
  "allow_model_fallback": false,
  "max_concurrent_subagents": 3,
  "coordinator": {
    "model": "gpt-6-astra",
    "reasoning_effort": "xhigh",
    "instruction_file": "instructions/coordinator.md",
    "explicit_launch_required": true
  },
  "target": {
    "file": "common/problem_statement.md",
    "initial_id": "S0",
    "mode": "exact",
    "prescribed_intensity": true,
    "orders": [
      2,
      3,
      4
    ],
    "full_product_densities": true,
    "initial_upper_diameter_bound": null,
    "initial_lower_distance_cutoff": null,
    "initial_triangle_altitude_cutoff": null,
    "initial_tetrahedron_altitude_cutoff": null,
    "finite_fourth_moment_required": false,
    "finite_moment_subclass_separate": true,
    "isotropy_required": false,
    "mixing_required": false,
    "approximation_is_success": false,
    "restricted_result_is_success": false
  },
  "run_root": "runs/",
  "source_manifest": "setup_audit/copied_sources.json",
  "context_policy": {
    "history_fork": "none",
    "explicit_packet_hashes": true,
    "proof_tracks_may_read_each_other": false,
    "reviewer_receives_author_conversation": false,
    "initial_obstruction_agents_may_read_starting_information": false,
    "common_seed_for_all_construction_tracks": true,
    "only_coordinator_dispatches": true,
    "filesystem_scopes_are_security_boundaries": false
  },
  "accounting": {
    "instruction_file": "instructions/accounting.md",
    "preflight_required": true,
    "unavailable_exact_usage": "disclose_before_research_and_request_owner_decision",
    "unknown_json_value": null,
    "unknown_display": "NR",
    "private_chain_of_thought": false,
    "structured_reasoning_summaries": true,
    "per_agent_per_turn": true,
    "distinguish_estimates_from_measurements": true
  },
  "revision_policy": {
    "coordinator_authority": "reviewed_general_obstruction_within_its_scope",
    "class_specific_failure_can_restrict_general_target": false,
    "owner_amendment_after_attempt": 3,
    "owner_approval_required": true,
    "silence_is_approval": false,
    "broadcast_to_all_roles": true,
    "preserve_initial_target_verdict": true,
    "automatic_attempt_reset": false,
    "exactness_fullness_orders_intensity_changes_require_owner": true
  },
  "attempt_policy": {
    "construction_max_submissions": 4,
    "construction_initial_submissions": 1,
    "construction_max_repairs": 3,
    "optional_owner_checkpoint_after": 3,
    "obstruction_max_submissions": 4,
    "technical_retry_consumes_attempt": false,
    "unsuccessful_approach_implies_nonexistence": false
  },
  "roles": {
    "nonexistence_1": {
      "description": "Independent global non-existence investigation.",
      "phase": "obstruction",
      "instruction_file": "instructions/nonexistence_agent.md",
      "approach_file": "approaches/00_nonexistence_global.md",
      "context_files": [
        "AGENTS.md",
        "instructions/nonexistence_agent.md",
        "instructions/accounting.md",
        "common/README.md",
        "common/problem_statement.md",
        "common/dvj_context.md",
        "common/papers/INDEX.md",
        "approaches/00_nonexistence_global.md",
        "templates/submission.md"
      ],
      "output_paths": [
        "$RUN/tracks/nonexistence_1/work/",
        "$RUN/tracks/nonexistence_1/submissions/"
      ],
      "model": "gpt-6-astra",
      "reasoning_effort": "xhigh",
      "fresh_context": true,
      "delegation_allowed": false,
      "starting_information_allowed": false,
      "native_agent_file": ".codex/agents/nonexistence_1.toml"
    },
    "nonexistence_2": {
