  "stages": [
    {
      "id": "preflight",
      "owner": "coordinator",
      "depends_on": [],
      "gates": [
        "model_selection_verified",
        "accounting_available_or_owner_accepts_limitations",
        "offline_setup_validation"
      ]
    },
    {
      "id": "freeze_inputs",
      "owner": "coordinator",
      "depends_on": [
        "preflight"
      ],
      "outputs": [
        "run_manifest.json",
        "statements/S0.md",
        "source_hashes.json",
        "agent_accounting.jsonl"
      ]
    },
    {
      "id": "independent_obstructions",
      "roles": [
        "nonexistence_1",
        "nonexistence_2"
      ],
      "depends_on": [
        "freeze_inputs"
      ],
      "fresh_contexts": true,
      "parallel": true
    },
    {
      "id": "obstruction_review",
      "roles": [
        "reviewer"
      ],
      "depends_on": [
        "independent_obstructions"
      ],
      "fresh_context_each_submission": true,
      "optional_roles": [
        "literature",
        "coder"
      ]
    },
    {
      "id": "adopt_and_broadcast_target",
      "owner": "coordinator",
      "depends_on": [
        "obstruction_review"
      ],
      "requires_reviewed_obstruction_for_coordinator_change": true
    },
    {
      "id": "independent_constructions",
      "roles": [
        "proof_1",
        "proof_2",
        "proof_3",
        "proof_4"
      ],
      "depends_on": [
        "adopt_and_broadcast_target"
      ],
      "fresh_contexts": true,
      "batch_limit": 3,
      "optional_roles": [
        "literature"
      ]
    },
    {
      "id": "construction_review_loop",
      "roles": [
        "reviewer"
      ],
      "depends_on": [
        "independent_constructions"
      ],
      "max_submissions_per_track": 4,
      "owner_request_after_unsuccessful_reviews": 3,
      "optional_roles": [
        "literature",
        "coder"
      ],
      "fresh_initial_reviews": true
    },
    {
      "id": "final_synthesis",
      "roles": [
        "reviewer"
      ],
      "depends_on": [
        "construction_review_loop"
      ],
      "outputs": [
        "review_report.md",
        "reasoning_summary.md",
        "target_history.md",
        "usage_cost_summary.md"
      ]
    }
  ],
  "communication": {
    "allowed_shared_new_work": "reviewed obstruction/target amendments and neutral source additions only",
    "construction_track_cross_talk": false,
    "review_feedback": "relevant author only",
    "owner_amendment": "after attempt 3, explicit approval before enactment",
    "all_adopted_targets": "broadcast to every logical role, including queued roles"
  }
}

